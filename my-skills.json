{
  "$comment": "my-skills project config. Generated by /my-skills:init \u2014 edit freely. Ownership globs are enforced for my-skills subagents.",
  "stack": [
    "Nuxt 4.5",
    "Vue 3",
    "Tailwind 4",
    "GSAP 3.15",
    "Lenis",
    "Sanity (blog)",
    "Web3Forms",
    "Vercel"
  ],
  "commands": {
    "dev": "npm run dev",
    "test": "npm test",
    "build": "npm run build",
    "typecheck": "npm run typecheck"
  },
  "verify": [
    "typecheck",
    "test"
  ],
  "ownership": {
    "frontend": [
      "app/components/**",
      "app/pages/**",
      "app/assets/**",
      "app/plugins/**",
      "app/utils/**",
      "app/app.vue",
      "public/**"
    ],
    "backend": [
      "server/**",
      "studio/schemas/**",
      "studio/structure.ts",
      "studio/sanity.config.ts"
    ],
    "devops": [
      "vercel.json",
      ".github/**"
    ],
    "web-quality": [
      "app/components/**",
      "app/pages/**",
      "nuxt.config.ts",
      "specs/audits/**"
    ],
    "shared": [
      ".env.example",
      "README.md",
      "docs/**"
    ]
  },
  "deploy": {
    "platform": "vercel",
    "productionBranch": "main"
  },
  "format": true,
  "allowEnvWrites": false
}
