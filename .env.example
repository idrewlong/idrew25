NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-20
SANITY_READ_TOKEN=your-sanity-viewer-token
# Optional: raises GitHub's rate limit for the "Now shipping" feed
NUXT_GITHUB_TOKEN=
# Teardown ops panel. Shared secret the ops-monitor GitHub Action sends when it
# reports uptime checks and Lighthouse runs; set the same value as the
# OPS_INGEST_SECRET repo secret. Generate with: openssl rand -hex 32
NUXT_OPS_INGEST_SECRET=
# AI assistant. Leave the key empty to hide the assistant entirely.
# Set a monthly spend limit on this key in the Anthropic Console.
NUXT_ANTHROPIC_API_KEY=
# NUXT_ASSISTANT_MODEL=claude-haiku-5-5   # default; claude-sonnet-5-5 or claude-opus-5-5 for a bigger model
# NUXT_ASSISTANT_DAILY_CAP=300           # model calls per day, all visitors
# Shared rate-limit storage for the assistant (required in production).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=
